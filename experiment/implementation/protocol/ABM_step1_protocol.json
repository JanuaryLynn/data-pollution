  "validation": {
    "all_numeric_finite": true,
    "joint_constraints": [
      "2 * ba-m < num-nodes",
      "beta0 * (1 + amplification) <= 1"
    ],
    "no_zero_as_missing": true,
    "reject_invalid_instead_of_silent_clipping": true,
    "nonnegative_count_rounding": "floor(x + 0.5)",
    "fixed_mode_kappa_canonical_value": 1,
    "inactive_parameters": "retain specified defaults; no default targeting alias"
  },
  "mechanics": {
    "step_order": [
      "reset_step_counters",
      "spread_from_start_of_step_polluted_sources",
      "count_polluted_pre_review",
      "govern_if_scheduled",
      "update_counters_and_accumulators",
      "advance_tick_and_record"
    ],
    "legal_output_steps": "1 + j * legal-response-time, j >= 0, step <= max-ticks",
    "legal_scheduled_opportunities": "1 + floor((max-ticks - 1) / legal-response-time)",
    "early_stop_at_zero_pollution": false,
    "review_candidate_universe": "all_nodes",
    "selection_within_step": "without_replacement",
    "targeted_ties": "random each review; superspreader ties random once during setup",
    "fixed_platform_review_count": "min(N, floor(N * platform-speed / 100 + 0.5))",
    "responsive_platform_review_count": "min(N, floor(N * platform-speed / 100 + 0.5), floor(demand-kappa * polluted_pre_review + 0.5))",
    "error_definition": "TP purifies polluted; FN leaves polluted; FP marks clean as ever wronged; TN leaves clean",
    "step_invariant": "reviews = TP + FP + TN + FN",
    "output_mode_rng_neutrality_required": true
  },
